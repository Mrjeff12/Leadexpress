# ── Required ──────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Maps ─────────────────────────────────────
VITE_MAPBOX_TOKEN=pk.your-mapbox-token

# ── WhatsApp Listener API ────────────────────
# In production: set to your deployed wa-listener URL
# In dev: http://localhost:3001
VITE_WA_LISTENER_URL=http://localhost:3001

# ── Error Tracking (optional, recommended) ───
# Create a project at https://sentry.io
VITE_SENTRY_DSN=
